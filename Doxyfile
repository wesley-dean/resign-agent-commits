PROJECT_NAME           = "$(RESIGN_AGENT_COMMITS_DOXYGEN_PROJECT_NAME)"
PROJECT_BRIEF          = "Reference documentation for resign-agent-commits"
OUTPUT_DIRECTORY       = doc/reference
CREATE_SUBDIRS         = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = .
GENERATE_LATEX         = NO
INPUT                  = src doc/adr doc/resign-agent-commits-spec.md doc/threat-model.md
RECURSIVE              = YES
FILE_PATTERNS          = *.bash *.sh *.md
EXCLUDE                = dist tests vendor doc/reference doc/standards doc/adr/README.intro.md doc/adr/README.outro.md doc/adr/templates
EXTENSION_MAPPING      = bash=C sh=C
FILTER_PATTERNS        = *.bash=vendor/doxygen-bash.awk *.sh=vendor/doxygen-bash.awk
EXTRACT_ALL            = NO
OPTIMIZE_OUTPUT_FOR_C  = YES
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = doc/adr/README.md
QUIET                  = YES
WARNINGS               = YES
WARN_IF_DOC_ERROR      = YES
